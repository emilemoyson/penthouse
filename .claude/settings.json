{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npx tsc --noEmit*)",
      "Bash(npm run build)",
      "Bash(npm run lint*)",
      "Bash(npx eslint *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git branch)",
      "Bash(git branch --show-current)",
      "Bash(createdb -p 5433 -T hub hub_test)",
      "Bash(dropdb -p 5433 hub_test)",
      "Bash(psql postgres://localhost:5433/hub_test *)",
      "Bash(scripts/.venv-lidl/bin/python scripts/lidl_sync.py --dry-run*)",
      "Bash(tail -n * ~/Library/Logs/lidl-sync.log)"
    ],
    "deny": [
      "Read(./.env.local)",
      "Read(./.env)",
      "Read(./scripts/.env)",
      "Edit(./.env.local)",
      "Edit(./.env)",
      "Edit(./scripts/.env)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-bash.mjs\"", "timeout": 10 }]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-edit.mjs\"", "timeout": 10 }]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/after-edit.mjs\"", "timeout": 60, "statusMessage": "Linting" }]
      }
    ],
    "Stop": [
      {
        "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/on-stop.mjs\"", "timeout": 120, "statusMessage": "Type-checking" }]
      }
    ],
    "Notification": [
      {
        "hooks": [{ "type": "command", "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/notify.sh\"", "timeout": 10 }]
      }
    ]
  }
}
