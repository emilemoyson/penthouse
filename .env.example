# Login password for the dashboard (pick something long)
APP_PASSWORD=

# Postgres connection string. Added automatically when you connect a Neon database in Vercel → Storage.
DATABASE_URL=

# Job Search 2027 sheet feed (see apps-script/JobsFeed.gs)
JOBS_SHEET_URL=
JOBS_SHEET_TOKEN=

# Bearer token for POST /api/ingest/{sleep|meals|groceries|emails|events|todos|workout-text} (any long random string)
INGEST_TOKEN=

# Claude API key (console.anthropic.com). Reads receipt photos and typed grocery lists in the kitchen,
# and fills in macros for items without them. Optional: the grocery form works without it.
ANTHROPIC_API_KEY=
